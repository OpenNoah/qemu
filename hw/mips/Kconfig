config MALTA
    bool
    default y
    depends on MIPS
    imply PCNET_PCI
    imply PCI_DEVICES
    imply TEST_DEVICES
    select FDC37M81X
    select GT64120
    select MIPS_CPS
    select PIIX
    select PFLASH_CFI01
    select SERIAL_MM
    select SMBUS_EEPROM

config MIPSSIM
    bool
    default y
    depends on MIPS
    select SERIAL_MM
    select MIPSNET

config IRIVER_D88
    bool
    select INGENIC_JZ4755
    select AR1010
    select WM8731
    select STMPE2403
    select D88_MATRIX_KEYPAD

config NOAH_NP1380
    bool
    select INGENIC_JZ4740

