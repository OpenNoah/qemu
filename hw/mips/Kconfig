    select SPLIT_IRQ
    select INGENIC_CGU
    select INGENIC_EMC
    select INGENIC_BCH
    select INGENIC_GPIO
    select INGENIC_UART
    select INGENIC_ADC
    select INGENIC_RTC
    select INGENIC_TCU
    select INGENIC_LCD
    select INGENIC_DMAC
    select INGENIC_INTC
    select INGENIC_I2C
    select INGENIC_MSC
    select INGENIC_AIC
    select INGENIC_UDC

